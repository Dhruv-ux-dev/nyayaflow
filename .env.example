# Copy to .env and adjust. Docker Compose reads this file automatically.

# PostgreSQL credentials (used by the database container and the API)
DB_USERNAME=nyayaflow
DB_PASSWORD=nyayaflow

# Secret for signing session tokens: at least 32 bytes, e.g. the output of `openssl rand -base64 48`.
# If empty, the API generates a random key at start-up and every restart signs everyone out.
NYAYAFLOW_JWT_SECRET=

# Load the demo courts, users and cases into an empty database.
NYAYAFLOW_SEED_DEMO_DATA=true
